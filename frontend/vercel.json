{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "node scripts/check-vercel-config.mjs && npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://YOUR-NGROK-DOMAIN.ngrok-free.app/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
