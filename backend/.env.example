DATABASE_URL=postgresql+psycopg://pc_app:CHANGE_ME@localhost:5432/pc_configurator
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME
# Encrypts the users vault (email, password hash). Keep it secret and backed up
# apart from the vault file: losing it makes every account unreadable.
# Generate one with: python -c "import base64, secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
VAULT_KEY=CHANGE_ME
# Folder for the activity log (logins, failed logins, saved builds, with emails).
# Rotated at AUDIT_LOG_MAX_BYTES, keeping AUDIT_LOG_BACKUP_COUNT old files.
# AUDIT_LOG_DIR=D:/pc-configurator-logs
# AUDIT_LOG_MAX_BYTES=5242880
# AUDIT_LOG_BACKUP_COUNT=10
# Your free ngrok static domain, used by scripts\start-public.ps1 to make this API
# reachable from the website. Not read by the app itself.
# NGROK_DOMAIN=your-name.ngrok-free.app
# Sites on another domain allowed to call the API from the browser, comma-separated.
# For GitHub Pages: CORS_ORIGINS=https://csdevjs.github.io
# CORS_ORIGINS=
# Where the users vault and the activity log go. Outside Vercel: file and file.
# On Vercel (VERCEL=1, whose disk isn't kept) the defaults are database and stderr.
# VAULT_STORAGE=file
# AUDIT_LOG_TO=file
